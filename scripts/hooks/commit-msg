#!/bin/sh
# commit-msg — message-aware checks. Runs after pre-commit, receives the
# prospective commit-message file as $1, so the L1/L2 bypass tokens can be honored.
set -u

MSG_FILE="$1"
# Resolve an interpreter that actually RUNS, not merely one that resolves on PATH — see
# the same guard in pre-commit. On Windows `python3` resolves to a Microsoft Store
# app-execution alias that exists but is not a working interpreter.
PY=""
for cand in python3 python py; do
  if command -v "$cand" >/dev/null 2>&1 && "$cand" --version >/dev/null 2>&1; then
    PY="$cand"
    break
  fi
done
if [ -z "${PY:-}" ]; then
  echo "[hooks] no working python found — cannot run integrity checks; commit blocked (fail-safe)" >&2
  exit 1
fi
HOOKS_DIR="$(git rev-parse --show-toplevel)/scripts/hooks"

# 1. Conventional-commit first line (re-chains the global protection).
#    Allowed besides type(scope): subject — merge/revert commits, fixup!/squash!, [infra:*] Action prefixes.
first_line="$(head -n 1 "$MSG_FILE")"
if ! printf '%s' "$first_line" | grep -Eq '^((feat|fix|docs|chore|refactor|test|style|perf|ci|build|revert)(\([^)]+\))?!?: .+|(Merge|Revert) .+|fixup! .+|squash! .+|\[infra:.+)'; then
  echo "[hooks] first line must be conventional-commit format (type: subject); got: $first_line" >&2
  exit 1
fi

# 1b. No co-authorship or tool-attribution footers (re-chains the global protection).
#     Once core.hooksPath points at scripts/hooks, the global
#     commit-msg hook no longer runs in this clone, and this was the one check it made
#     that this file did not. Until then the rule was prose only wherever these hooks ran.
if grep -qiE 'Co-Authored-By:|Generated with Claude Code' "$MSG_FILE"; then
  echo "[hooks] commit messages must not include co-authorship attribution or Claude Code footers" >&2
  exit 1
fi

# 2. L1 strict append-only (bypass: [allow-prune: monthly-archive]).
"$PY" "$HOOKS_DIR/append_only.py" --commit-msg-file "$MSG_FILE" || exit 1

# 3. L2 lossy-rewrite heuristic (bypass: [allow-rewrite: weekly] / [allow-rewrite: monthly]).
"$PY" "$HOOKS_DIR/diff_heuristic.py" --commit-msg-file "$MSG_FILE" || exit 1

# 4. PII/secret scan of the MESSAGE ITSELF. pre-commit gates the
#    staged content; nothing gated the prose describing it -- and prose is where
#    sensitive detail actually lands, because writing about a redaction
#    reproduces the thing being redacted. NO bypass token, same as the content
#    scan. Uses --text-file, NOT --files: $MSG_FILE is .git/COMMIT_EDITMSG and
#    is_excluded() skips anything under .git/, so --files would exit 0 having
#    scanned nothing. --text-file reports under a label instead, so it always runs.
"$PY" "$HOOKS_DIR/pii_scan.py" --text-file "$MSG_FILE" --label "<commit-msg>" || {
  echo "[hooks] commit message contains PII/secrets — rewrite the message." >&2
  echo "[hooks] describe what changed without reproducing the sensitive value." >&2
  exit 1
}

exit 0
